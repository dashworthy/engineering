.DS_Store

# .claude/settings.json IS committed — it carries the deny rules that block writes to the
# retired top-level signal/, verity/, and vernacular/ directories (renamed into the plugin
# long ago; acceptance.sh asserts they never come back), and it only helps if it travels
# with the repo. settings.local.json stays personal: it holds machine-specific absolute paths.
.claude/settings.local.json
.engineering/

# eval run artifacts — `claude plugin eval` writes timestamped reports here on every run;
# they are outputs, not suite source, so they never get committed.
evals/results/
